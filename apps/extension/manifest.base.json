{
  "manifest_version": 3,
  "name": "Mesurer - Inspect, annotate, and give feedback on any live interface",
  "description": "Mesurer runs directly where you build. Share feedback with your agents and your team.",
  "version": "0.0.0",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://mesurer.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://mesurer.dev/*"
      ],
      "js": ["capture-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle Mesurer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
